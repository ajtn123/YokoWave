{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ajtn123/YokoWave/main/schemas/waveform.schema.json",
  "title": "YokoWave waveform",
  "description": "A version 1 waveform asset. Import and storage files contain an array of these objects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["FormatVersion", "Id", "Name", "Shape", "PeriodSeconds", "Frequency"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "FormatVersion": { "const": 1 },
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "Name": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
    "Shape": { "enum": ["Sine", "Triangle", "Pulse", "Ramp", "Custom", "Sampled"] },
    "PeriodSeconds": { "type": "number", "minimum": 0.2, "maximum": 60 },
    "Frequency": { "type": "number", "minimum": 1, "maximum": 100 },
    "Points": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/points" }] },
    "Samples": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/samples" }] },
    "NameKey": { "type": "string", "minLength": 1, "description": "Optional built-in localization key." },
    "SourceId": { "type": "integer", "minimum": 0, "description": "Optional source-data identifier; ignored during playback." }
  },
  "allOf": [
    {
      "if": { "properties": { "Shape": { "const": "Custom" } }, "required": ["Shape"] },
      "then": { "required": ["Points"], "properties": { "Points": { "$ref": "#/$defs/points" } } }
    },
    {
      "if": { "properties": { "Shape": { "const": "Sampled" } }, "required": ["Shape"] },
      "then": { "required": ["Samples"], "properties": { "Samples": { "$ref": "#/$defs/samples" } } }
    }
  ],
  "$defs": {
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "points": { "type": "array", "minItems": 2, "maxItems": 256, "items": { "$ref": "#/$defs/ratio" } },
    "samples": { "type": "array", "minItems": 2, "maxItems": 512, "items": { "$ref": "#/$defs/sample" } },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Level", "FrequencyHz", "PulseWidth"],
      "properties": {
        "Level": { "$ref": "#/$defs/ratio" },
        "FrequencyHz": { "type": "number", "minimum": 1, "maximum": 100 },
        "PulseWidth": { "$ref": "#/$defs/ratio" },
        "Channels": {
          "description": "Signed A/B/C multipliers. Omitted/null means a shared multiplier of 1; without explicit channel arrays the waveform has only source channel A. Explicit arrays define their first 1–3 channels; absent entries are zero.",
          "anyOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "number", "minimum": -1, "maximum": 1 } }
          ]
        }
      }
    }
  }
}
