  <Thickness x:Key="Margin.ListItem">0,0,0,12</Thickness>
  <Thickness x:Key="Margin.Tile">0,0,8,8</Thickness>
  <Thickness x:Key="Margin.AboveSmall">0,8,0,0</Thickness>
  <Thickness x:Key="Margin.AboveMedium">0,12,0,0</Thickness>
