<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared type and spacing scales; colors remain in Palette.axaml. -->
  <x:Double x:Key="FontSize.FinePrint">9</x:Double>
  <x:Double x:Key="FontSize.Caption">10</x:Double>
  <x:Double x:Key="FontSize.Label">11</x:Double>
  <x:Double x:Key="FontSize.Small">12</x:Double>
  <x:Double x:Key="FontSize.Body">13</x:Double>
  <x:Double x:Key="FontSize.CardTitle">14</x:Double>
  <x:Double x:Key="FontSize.SectionTitle">16</x:Double>
  <x:Double x:Key="FontSize.Brand">19</x:Double>
  <x:Double x:Key="FontSize.Title">20</x:Double>
