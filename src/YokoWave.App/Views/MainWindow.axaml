<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:YokoWave.App.Localization"
        xmlns:views="using:YokoWave.App.Views"
        x:Class="YokoWave.App.Views.MainWindow"
        Width="{DynamicResource Size.MainWindowWidth}" Height="{DynamicResource Size.MainWindowHeight}" MinWidth="{DynamicResource Size.MainWindowMinWidth}" MinHeight="{DynamicResource Size.MainWindowMinHeight}"
        Title="{l:Loc App.Title}" Icon="avares://YokoWave.App/Assets/YokoWave.ico" WindowStartupLocation="CenterScreen">
  <views:MainView />
</Window>
