<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:YokoWave.App.Localization"
        xmlns:views="using:YokoWave.App.Views"
        x:Class="YokoWave.App.Views.MainWindow"
        Width="1000" Height="600" MinWidth="600" MinHeight="600"
        Title="{l:Loc App.Title}" WindowStartupLocation="CenterScreen">
  <views:MainView />
</Window>
