<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Pages.SettingsView"
             x:DataType="vm:MainViewModel">
  <StackPanel Classes="section settings">
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Settings.Language}" Classes="title" />
        <ComboBox x:Name="LanguagePicker" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Classes="language-picker">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LanguageOption"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Settings.Appearance}" Classes="title" />
        <TextBlock Text="{l:Loc Settings.AppearanceHelp}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="group">
        <TextBlock Text="{l:Loc Settings.Output}" Classes="title" />
        <StackPanel Classes="field">
          <TextBlock Text="{l:Loc Settings.Transport}" Classes="field-label" />
          <ComboBox x:Name="TransportPicker" ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransport}" Classes="language-picker">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TransportOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBlock Text="{Binding DriverLabel}" Classes="accent" />
        <TextBlock Text="{Binding TransportHelp}" Classes="muted help" />
        <TextBlock Text="{l:Loc Settings.DefaultLimit}" Classes="small" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{DynamicResource Column.SettingValue}" />
          </Grid.ColumnDefinitions>
          <Slider Value="{Binding DefaultLimit}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
          <TextBlock Grid.Column="1" Text="{Binding DefaultLimit, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="accent" />
        </Grid>
        <StackPanel Classes="field">
          <TextBlock Text="{l:Loc Settings.TimerLimit}" Classes="field-label" />
          <StackPanel Classes="inline">
            <NumericUpDown x:Name="TimerLimitInput" Value="{Binding TimerLimitMinutes}" Minimum="1" Maximum="120" Increment="1" FormatString="0" Classes="setting-value" />
            <TextBlock Text="{l:Loc Unit.Minutes}" Classes="muted label" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <CheckBox Content="{l:Loc Settings.Offset}" IsChecked="{Binding OffsetChannelB}" />
        <Button x:Name="SaveSettingsButton" Classes="primary" Command="{Binding SaveSettingsCommand}" Content="{l:Loc Settings.Save}" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Settings.Storage}" Classes="title" />
        <TextBlock Text="{l:Loc Settings.StorageHelp}" Classes="muted help" />
        <TextBlock Text="{l:Loc Settings.DataPath}" Classes="label" />
        <SelectableTextBlock Text="{Binding StoragePath}" TextWrapping="Wrap" Classes="label channel-b" />
        <TextBlock Text="{l:Loc Settings.StopHelp}" Classes="muted help" />
      </StackPanel>
    </Border>
    <TextBlock Text="{l:Loc App.Version}" Margin="{DynamicResource Margin.AllSmall}" Classes="small muted" />
  </StackPanel>
</UserControl>
