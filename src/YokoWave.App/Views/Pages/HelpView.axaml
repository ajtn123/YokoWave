<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Pages.HelpView">
  <StackPanel Classes="section reading">
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Template.WebSocketServer}" Classes="section-title" />
        <TextBlock Text="{l:Loc Remote.ServerHelp}" Classes="help" />
        <TextBlock Text="{l:Loc Remote.ClientHelp}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.HardwareTitle}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Hardware}" Classes="help" />
        <TextBlock Text="{l:Loc Help.HardwareWaves}" Classes="muted help" />
        <TextBlock Text="{l:Loc Help.Sensors}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Template.Pump}" Classes="section-title" />
        <TextBlock Text="{l:Loc Pump.Help}" Classes="help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.StopTitle}" Classes="section-title" />
        <TextBlock x:Name="HelpStopInfoText" Text="{l:Loc Help.StopBehavior}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Disconnection}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.ConnectTitle}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Connect}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Discovery}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.OutputTitle}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Output}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Readings}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.TimerTitle}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Timer}" Classes="help" />
        <TextBlock Text="{l:Loc Help.TimerLimit}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.LinkedTitle}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Linked}" Classes="help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.WavesTitle}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.LiveWave}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Playback}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Waves}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.StorageTitle}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Storage}" Classes="help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Estim.StrengthProgram}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.StrengthProgram}" Classes="help" />
        <TextBlock Text="{l:Loc Help.DeviceFeatures}" Classes="muted help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Touch.Title}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Touch}" Classes="help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Template.Audio}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.AudioControl}" Classes="help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Template.Restraint}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Restraint}" Classes="help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Template.Exercise}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Exercise}" Classes="help" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Template.SleepDeprivation}" Classes="section-title" />
        <TextBlock Text="{l:Loc Help.Sleep}" Classes="help" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
