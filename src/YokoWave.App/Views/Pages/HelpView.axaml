<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Pages.HelpView">
  <StackPanel Classes="section reading">
    <Border Classes="card">
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.QuickStart.Title}" Classes="card-title" />
        <TextBlock Text="{l:Loc Help.QuickStart.Connect}" Classes="help" />
        <TextBlock Text="{l:Loc Help.QuickStart.Create}" Classes="help" />
        <TextBlock Text="{l:Loc Help.QuickStart.Run}" Classes="help" />
      </StackPanel>
    </Border>
    <Expander x:Name="DevicesHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Devices.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Devices.Connect}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Devices.AutoConnect}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Devices.Models}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Devices.Hardware}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="GraphHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Graph.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Graph.Groups}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Graph.Nodes}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Graph.Disconnect}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Graph.Templates}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Graph.Saving}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="OutputHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Output.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Output.Values}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Output.Readings}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Output.Timer}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Output.TimerLimit}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="WaveformsHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Waveforms.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Waveforms.Library}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Waveforms.Channels}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Waveforms.Playlist}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Waveforms.Live}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="InputsHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Inputs.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Inputs.StrengthTitle}" Classes="card-title" />
        <TextBlock Text="{l:Loc Help.Inputs.Strength}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Inputs.TouchTitle}" Classes="card-title" />
        <TextBlock Text="{l:Loc Help.Inputs.Touch}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Inputs.AudioTitle}" Classes="card-title" />
        <TextBlock Text="{l:Loc Help.Inputs.AudioSource}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Inputs.AudioWaiting}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Inputs.RestraintTitle}" Classes="card-title" />
        <TextBlock Text="{l:Loc Help.Inputs.Restraint}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Inputs.ExerciseTitle}" Classes="card-title" />
        <TextBlock Text="{l:Loc Help.Inputs.Exercise}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Inputs.SleepTitle}" Classes="card-title" />
        <TextBlock Text="{l:Loc Help.Inputs.Sleep}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Inputs.Simulation}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="NativeHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Native.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Native.Programs}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Native.Pump}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="ProtocolHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Protocol.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Protocol.Commands}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Protocol.Sensors}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="RemoteHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Remote.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Remote.Server}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Remote.Kinds}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Remote.Client}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Remote.DgLabSource}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Remote.DgLabControlled}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Remote.DgLabRelay}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="StopHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Stop.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock x:Name="HelpStopInfoText" Text="{l:Loc Help.Stop.Behavior}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Stop.Failure}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="DataHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Data.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Data.Settings}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Data.Storage}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Data.Clear}" Classes="help" />
      </StackPanel>
    </Expander>
    <Expander x:Name="TroubleshootingHelpTopic" HorizontalAlignment="Stretch">
      <Expander.Header><TextBlock Text="{l:Loc Help.Troubleshooting.Title}" Classes="card-title help" /></Expander.Header>
      <StackPanel Classes="items">
        <TextBlock Text="{l:Loc Help.Troubleshooting.Scan}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Troubleshooting.Output}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Troubleshooting.Audio}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Troubleshooting.Remote}" Classes="help" />
        <TextBlock Text="{l:Loc Help.Troubleshooting.Storage}" Classes="help" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
