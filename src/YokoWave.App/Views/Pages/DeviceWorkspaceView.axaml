<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             xmlns:components="using:YokoWave.App.Views.Components"
             x:Class="YokoWave.App.Views.Pages.DeviceWorkspaceView" x:DataType="vm:DevicesPaneViewModel">
  <Grid x:Name="WorkspaceGrid" Classes="workspace" ColumnDefinitions="Auto,*" RowDefinitions="Auto">
    <StackPanel x:Name="DevicePane" Classes="group">
      <components:DeviceConnectionListView />
    </StackPanel>
    <StackPanel x:Name="ControlPane" Grid.Column="1" Classes="group">
      <Border Classes="card detail">
        <StackPanel Classes="items">
          <TextBlock Text="{Binding SelectedName}" Classes="title" />
          <TextBlock Text="{Binding SelectedKind}" Classes="muted label" />
          <SelectableTextBlock Text="{Binding SelectedId}" Classes="caption muted" />
          <TextBlock Text="{Binding SelectedBatteryLabel}" Classes="label" />
          <TextBlock Text="{Binding SelectedSignal}" Classes="caption muted" />
          <TextBlock Text="{Binding SelectedContacts}" IsVisible="{Binding HasElectrodeReadings}" Classes="caption muted" />
          <TextBlock Text="{Binding DeviceHelp}" Classes="caption muted" TextWrapping="Wrap" />
          <components:DeviceFeaturesView />
          <ItemsControl ItemsSource="{Binding HardwareSelection}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DeviceHardwareOptionsViewModel"><components:DeviceHardwareOptionsView /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <components:DeviceTelemetryView DataContext="{Binding Telemetry}" />
      <components:DgLabDeviceStateView DataContext="{Binding DgLabState}" />
      <components:ProtocolFeaturesView DataContext="{Binding ProtocolFeatures}" />
      <components:RemoteSourcesView DataContext="{Binding RemoteSources}" />
    </StackPanel>
  </Grid>
</UserControl>
