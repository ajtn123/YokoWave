<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization"
             xmlns:controls="using:YokoWave.App.Controls"
             xmlns:components="using:YokoWave.App.Views.Components"
             x:Class="YokoWave.App.Views.Pages.DeviceWorkspaceView"
             x:DataType="vm:MainViewModel">
  <StackPanel Classes="section">
    <Grid Classes="summary" ColumnDefinitions="*,*,*">
      <Border Classes="card summary">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Classes="field">
            <TextBlock Text="{l:Loc Device.Count}" Classes="muted label" />
            <TextBlock Text="{Binding ConnectedSummary}" Classes="metric" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="⌁" VerticalAlignment="Center" Classes="icon accent" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card summary">
        <StackPanel Classes="field">
          <TextBlock Text="{Binding SessionTimeLabel}" Classes="muted label" />
          <StackPanel Classes="actions">
            <TextBlock x:Name="SessionClockText" Text="{Binding SessionClock}" Classes="metric" />
            <TextBlock Text="{Binding SessionState}" VerticalAlignment="Center" Classes="caption channel-b" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card summary">
        <StackPanel Classes="field">
          <TextBlock Text="{l:Loc Wave.Current}" Classes="muted label" />
          <TextBlock x:Name="SelectedWaveNameText" Text="{Binding SelectedPresetName}" TextTrimming="CharacterEllipsis" Classes="title" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="WorkspaceGrid" Classes="workspace" ColumnDefinitions="Auto,*" RowDefinitions="Auto">
      <StackPanel x:Name="DevicePane" Classes="group">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{l:Loc Device.List}" VerticalAlignment="Center" Classes="section-title" />
          <Button Grid.Column="1" x:Name="ScanButton" Classes="small" Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DeviceItem">
              <Border Classes="list-item device-card" Classes.active="{Binding IsSelected}">
                <Grid RowDefinitions="Auto,Auto">
                  <Button Classes="device" Command="{Binding SelectCommand}">
                    <Grid RowDefinitions="Auto,Auto">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource Column.DeviceIcon}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.RowSpan="2" Classes="device-icon">
                        <TextBlock Text="{Binding Symbol}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="icon accent" />
                      </Border>
                      <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Classes="small emphasis" />
                      <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Kind}" TextTrimming="CharacterEllipsis" Classes="muted caption" Margin="{DynamicResource Margin.AboveSmall}" />
                      <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Status}" Classes="muted caption" Margin="{DynamicResource Margin.AboveSmall}" />
                    </Grid>
                  </Button>
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Classes="columns" Margin="{DynamicResource Margin.DeviceActions}">
                    <CheckBox Content="{l:Loc Device.IncludeLabel}" IsChecked="{Binding IsIncluded}" IsEnabled="{Binding CanEditRouting}"
                              ToolTip.Tip="{l:Loc Device.Include}" Classes="compact caption" />
                    <Button Grid.Column="1" Classes="small connection-action" Classes.primary="{Binding !IsConnected}" Classes.danger="{Binding IsConnected}"
                            Command="{Binding ConnectCommand}" Content="{Binding ConnectionAction}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="inset-panel">
          <StackPanel Classes="field">
            <TextBlock Text="{l:Loc Device.Group}" Classes="small emphasis" />
            <ToggleSwitch x:Name="LinkModeToggle" IsChecked="{Binding LinkMode}" IsEnabled="{Binding CanEditRouting}" OnContent="{l:Loc Device.Synchronized}" OffContent="{l:Loc Device.Independent}" Classes="label" />
            <TextBlock Text="{l:Loc Device.GroupHelp}" Classes="muted caption help" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ControlPane" Grid.Column="1" Classes="group">
        <Border Classes="card detail">
          <StackPanel Classes="group">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Classes="field">
              <TextBlock Text="{Binding SelectedName}" Classes="title" />
              <TextBlock Text="{Binding SelectedKind}" Classes="muted label" />
              <TextBlock Text="{Binding SelectedContacts}" IsVisible="{Binding HasElectrodeReadings}" Classes="muted caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Classes="field">
              <TextBlock Text="{Binding SelectedBatteryLabel}" HorizontalAlignment="Right" Classes="label accent" />
              <TextBlock Text="{Binding SelectedSignal}" Classes="muted caption" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding ReadingsLabel}" Classes="muted fine-print" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <components:DeviceFeaturesView IsVisible="{Binding IsBluetooth}" />
          </StackPanel>
        </Border>

        <Border Classes="card output">
          <StackPanel Classes="group">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Classes="field">
                <TextBlock Text="{l:Loc Wave.Preview}" Classes="card-title" />
                <TextBlock Text="{l:Loc Wave.PreviewHelp}" Classes="muted caption" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Top" Classes="actions">
                <TextBlock Text="● A" Classes="label accent" />
                <TextBlock Text="● B" Classes="label channel-b" />
              </StackPanel>
            </Grid>
            <CheckBox Content="{l:Loc Touch.Title}" IsChecked="{Binding UseTouchControl}" IsEnabled="{Binding CanEditRouting}" />
            <Grid RowDefinitions="*,Auto" Classes="chart" IsVisible="{Binding IsWaveformControl}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Column.ChartAxis}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid RowDefinitions="*,*,*" Margin="{DynamicResource Margin.BelowLarge}">
                <TextBlock Text="100" Classes="fine-print muted" />
                <TextBlock Grid.Row="1" Text="50" VerticalAlignment="Center" Classes="fine-print muted" />
                <TextBlock Grid.Row="2" Text="0" VerticalAlignment="Bottom" Classes="fine-print muted" />
              </Grid>
              <controls:WaveformPlot Grid.Column="1" x:Name="MainPlot" Preset="{Binding SelectedWaveform}" PresetB="{Binding SelectedWaveformB}"
                  AmplitudeA="{Binding ChannelA}" AmplitudeB="{Binding ChannelB}" Offset="{Binding OffsetChannelB}" Playhead="{Binding Playhead}" />
              <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="{DynamicResource Margin.AboveSmall}">
                <TextBlock Text="0s" Classes="fine-print muted" />
                <TextBlock Grid.Column="1" Text="4s" HorizontalAlignment="Center" Classes="fine-print muted" />
                <TextBlock Grid.Column="2" Text="8s" HorizontalAlignment="Center" Classes="fine-print muted" />
                <TextBlock Grid.Column="3" Text="12s" HorizontalAlignment="Right" Classes="fine-print muted" />
              </Grid>
            </Grid>
            <components:WaveformPlaybackView IsVisible="{Binding IsWaveformControl}" />
            <components:TouchControlView IsVisible="{Binding UseTouchControl}" />
          </StackPanel>
        </Border>

        <Grid Classes="columns" ColumnDefinitions="*,*">
          <Border Classes="card channel">
            <StackPanel Classes="field">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:Loc Channel.A}" VerticalAlignment="Center" Classes="emphasis accent" />
                <TextBlock Grid.Column="1" Text="{Binding ChannelA, StringFormat='{}{0:0}%'}" Classes="metric" />
              </Grid>
              <Slider x:Name="ChannelASlider" Minimum="0" Maximum="{Binding SafetyLimit}" Value="{Binding ChannelA}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding SelectedConnected}" />
              <TextBlock x:Name="SelectedOutputAText" Text="{Binding SelectedOutputALabel}" Classes="muted caption" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card channel">
            <StackPanel IsEnabled="{Binding HasChannelB}" Classes="field">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:Loc Channel.B}" VerticalAlignment="Center" Classes="emphasis channel-b" />
                <TextBlock Grid.Column="1" Text="{Binding ChannelB, StringFormat='{}{0:0}%'}" Classes="metric" />
              </Grid>
              <Slider x:Name="ChannelBSlider" Minimum="0" Maximum="{Binding SafetyLimit}" Value="{Binding ChannelB}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding SelectedConnected}" />
              <TextBlock x:Name="SelectedOutputBText" Text="{Binding SelectedOutputBLabel}" Classes="muted caption" />
            </StackPanel>
          </Border>
        </Grid>

        <components:EstimAutomationView />
        <Border Classes="card session">
          <StackPanel Classes="items">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:Loc Device.Limit}" Classes="small emphasis" />
              <TextBlock Grid.Column="1" Text="{Binding SafetyLimit, StringFormat='{}{0:0}%'}" Classes="small accent" />
            </Grid>
            <Slider x:Name="LimitSlider" Minimum="0" Maximum="100" Value="{Binding SafetyLimit}" TickFrequency="5" IsSnapToTickEnabled="True" IsEnabled="{Binding SelectedConnected}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding RoutingSummary}" Classes="muted caption" VerticalAlignment="Center" />
              <CheckBox Grid.Column="1" IsChecked="{Binding OffsetChannelB}" IsEnabled="{Binding CanOffsetChannelB}" Content="{l:Loc Channel.Offset}" Classes="caption compact" />
            </Grid>
            <components:SessionTimerView />
            <Grid ColumnDefinitions="*,Auto" Classes="columns">
              <Button x:Name="PlaybackButton" Classes="primary" Command="{Binding PlaybackCommand}" Content="{Binding PlaybackLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="1" x:Name="PauseButton" Command="{Binding PauseCommand}" Content="{Binding PauseLabel}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding DeviceHelp}" Classes="caption muted help" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
