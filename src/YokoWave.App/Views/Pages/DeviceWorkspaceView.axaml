<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization"
             xmlns:controls="using:YokoWave.App.Controls"
             xmlns:components="using:YokoWave.App.Views.Components"
             x:Class="YokoWave.App.Views.Pages.DeviceWorkspaceView"
             x:DataType="vm:MainViewModel">
  <StackPanel Classes="section">
    <Grid Classes="summary" ColumnDefinitions="*,*,*">
      <Border Classes="card summary">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Classes="field">
            <TextBlock Text="{l:Loc Device.Count}" Classes="muted label" />
            <TextBlock Text="{Binding ConnectedSummary}" Classes="metric" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="⌁" VerticalAlignment="Center" Classes="icon accent" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card summary">
        <StackPanel Classes="field">
          <TextBlock Text="{Binding SessionTimeLabel}" Classes="muted label" />
          <StackPanel Classes="actions">
            <TextBlock x:Name="SessionClockText" Text="{Binding SessionClock}" Classes="metric" />
            <TextBlock Text="{Binding SessionState}" VerticalAlignment="Center" Classes="caption channel-b" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card summary">
        <StackPanel Classes="field">
          <TextBlock Text="{Binding SelectedMode.CurrentContentTitle}" Classes="muted label" />
          <TextBlock x:Name="SelectedWaveNameText" Text="{Binding SelectedPresetName}" TextTrimming="CharacterEllipsis" Classes="title" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="WorkspaceGrid" Classes="workspace" ColumnDefinitions="Auto,*" RowDefinitions="Auto">
      <StackPanel x:Name="DevicePane" Classes="group">
        <components:ModeDeviceListView />

        <Border Classes="card detail">
          <StackPanel Classes="group">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Classes="field">
              <TextBlock Text="{Binding SelectedName}" Classes="title" />
              <TextBlock Text="{Binding SelectedKind}" Classes="muted label" />
              <TextBlock Text="{Binding SelectedContacts}" IsVisible="{Binding HasElectrodeReadings}" Classes="muted caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Classes="field">
              <TextBlock Text="{Binding SelectedBatteryLabel}" HorizontalAlignment="Right" Classes="label accent" />
              <TextBlock Text="{Binding SelectedSignal}" Classes="muted caption" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding ReadingsLabel}" Classes="muted fine-print" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <components:DeviceFeaturesView IsVisible="{Binding IsBluetooth}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="ControlPane" Grid.Column="1" Classes="group">
        <components:ModeWorkspaceView />

        <components:WaveformModeView x:Name="WaveformModePanel" IsVisible="{Binding IsWaveformControl}" />
        <Border x:Name="TouchModePanel" Classes="card output" IsVisible="{Binding UseTouchControl}">
          <StackPanel Classes="group">
            <TextBlock Text="{l:Loc Touch.Title}" Classes="card-title" />
            <components:TouchControlView />
          </StackPanel>
        </Border>
        <components:AudioModeView DataContext="{Binding SelectedMode}" />
        <components:RestraintModeView DataContext="{Binding SelectedMode}" />
        <components:ExerciseModeView DataContext="{Binding SelectedMode}" />
        <components:SleepModeView DataContext="{Binding SelectedMode}" />
        <components:ReactiveInputView DataContext="{Binding SelectedMode}" />
        <Grid Classes="columns" ColumnDefinitions="*,*">
          <Border Classes="card channel">
            <StackPanel Classes="field">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:Loc Channel.A}" VerticalAlignment="Center" Classes="emphasis accent" />
                <TextBlock Grid.Column="1" Text="{Binding ChannelA, StringFormat='{}{0:0}%'}" Classes="metric" />
              </Grid>
              <Slider x:Name="ChannelASlider" Minimum="0" Maximum="100" Value="{Binding ChannelA}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock x:Name="SelectedOutputAText" Text="{Binding SelectedOutputALabel}" Classes="muted caption" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card channel">
            <StackPanel IsEnabled="{Binding HasChannelB}" Classes="field">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:Loc Channel.B}" VerticalAlignment="Center" Classes="emphasis channel-b" />
                <TextBlock Grid.Column="1" Text="{Binding ChannelB, StringFormat='{}{0:0}%'}" Classes="metric" />
              </Grid>
              <Slider x:Name="ChannelBSlider" Minimum="0" Maximum="100" Value="{Binding ChannelB}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock x:Name="SelectedOutputBText" Text="{Binding SelectedOutputBLabel}" Classes="muted caption" />
            </StackPanel>
          </Border>
        </Grid>

        <components:EstimAutomationView />
        <Border Classes="card session">
          <StackPanel Classes="items">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{l:Loc Device.Limit}" Classes="small emphasis" />
              <TextBlock Grid.Column="1" Text="{Binding SafetyLimit, StringFormat='{}{0:0}%'}" Classes="small accent" />
            </Grid>
            <Slider x:Name="LimitSlider" Minimum="0" Maximum="100" Value="{Binding SafetyLimit}" TickFrequency="5" IsSnapToTickEnabled="True" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding RoutingSummary}" Classes="muted caption" VerticalAlignment="Center" />
              <CheckBox Grid.Column="1" IsChecked="{Binding OffsetChannelB}" IsEnabled="{Binding CanOffsetChannelB}" Content="{l:Loc Channel.Offset}" Classes="caption compact" />
            </Grid>
            <components:SessionTimerView />
            <Grid ColumnDefinitions="*,Auto" Classes="columns">
              <Button x:Name="PlaybackButton" Classes="primary" Command="{Binding PlaybackCommand}" Content="{Binding PlaybackLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <Button Grid.Column="1" x:Name="PauseButton" Command="{Binding PauseCommand}" Content="{Binding PauseLabel}" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding DeviceHelp}" Classes="caption muted help" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
