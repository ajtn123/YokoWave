<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization"
             xmlns:controls="using:YokoWave.App.Controls"
             xmlns:components="using:YokoWave.App.Views.Components"
             x:Class="YokoWave.App.Views.Pages.WaveformLibraryView"
             x:DataType="vm:WaveformLibraryViewModel">
  <StackPanel Classes="section">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Classes="field">
        <TextBlock Text="{l:Loc Wave.LibraryHelp}" Classes="muted label" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Command="{Binding NewWaveCommand}" Content="{l:Loc Wave.New}" VerticalAlignment="Center" />
    </Grid>
    <ListBox x:Name="WaveList" ItemsSource="{Binding Waveforms}" SelectedItem="{Binding SelectedWaveform}" Classes="wave-library">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:WaveformItem">
          <Border Classes="card compact wave-tile">
            <StackPanel Classes="items">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Classes="card-title" />
                <TextBlock Grid.Column="1" Text="{Binding ShapeLabel}" Classes="muted caption" />
              </Grid>
              <controls:WaveformPlot Waveform="{Binding Asset}" Classes="thumbnail" />
              <TextBlock Text="{Binding Detail}" Classes="caption channel-b" />
              <TextBlock Text="{Binding Origin}" Classes="fine-print muted" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel Classes="actions">
      <Button Classes="primary" Content="{l:Loc Wave.Use}" Command="{Binding UseWaveCommand}" />
      <Button Content="{l:Loc Wave.Edit}" Command="{Binding EditWaveCommand}" />
      <Button x:Name="DeleteWaveButton" Content="{l:Loc Wave.Delete}" Command="{Binding DeleteWaveCommand}" Classes="danger" />
    </WrapPanel>
    <components:WaveformEditorView />
    <components:WaveformTransferView />
  </StackPanel>
</UserControl>
