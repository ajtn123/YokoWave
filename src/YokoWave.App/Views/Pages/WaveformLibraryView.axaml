<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization"
             xmlns:controls="using:YokoWave.App.Controls"
             xmlns:components="using:YokoWave.App.Views.Components"
             x:Class="YokoWave.App.Views.Pages.WaveformLibraryView"
             x:DataType="vm:MainViewModel">
  <StackPanel Spacing="22">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="{l:Loc Wave.LibraryHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Command="{Binding NewWaveCommand}" Content="{l:Loc Wave.New}" VerticalAlignment="Center" />
    </Grid>
    <ListBox x:Name="WaveList" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Padding="0" MaxHeight="350" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PresetItem">
          <Border Classes="card" Width="238" Padding="16" Margin="0,0,8,8">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ShapeLabel}" Classes="muted" FontSize="10" />
              </Grid>
              <controls:WaveformPlot Preset="{Binding Preset}" ShowGrid="False" Height="50" AmplitudeA="85" AmplitudeB="0" />
              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource ChannelBBrush}" FontSize="10" />
              <TextBlock Text="{Binding Origin}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Classes="primary" Content="{l:Loc Wave.Use}" Command="{Binding UseWaveCommand}" />
      <Button Content="{l:Loc Wave.Edit}" Command="{Binding EditWaveCommand}" />
      <Button x:Name="DeleteWaveButton" Content="{l:Loc Wave.Delete}" Command="{Binding DeleteWaveCommand}" />
    </StackPanel>
    <components:WaveformEditorView />
    <components:WaveformTransferView />
  </StackPanel>
</UserControl>
