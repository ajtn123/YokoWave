<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:controls="using:YokoWave.App.Controls"
             x:Class="YokoWave.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource CanvasBrush}">
  <Grid x:Name="Shell" ColumnDefinitions="194,*">
    <Border x:Name="Sidebar" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="18,32,18,22">
        <StackPanel Spacing="8" Margin="12,0,0,36">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Width="34" Height="34">
              <TextBlock Text="∿" Foreground="{DynamicResource OnAccentBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
            </Border>
            <TextBlock Text="YokoWave" FontWeight="Bold" FontSize="19" VerticalAlignment="Center" LetterSpacing="-0.6" />
          </StackPanel>
          <TextBlock Text="YOUR RHYTHM, CONNECTED." FontSize="8" LetterSpacing="1.3" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工作空间" Classes="eyebrow" Margin="16,0,0,12" />
          <Button Classes="nav" Classes.active="{Binding IsWorkspace}" Command="{Binding WorkspaceCommand}" Content="▦    设备工作台" />
          <Button Classes="nav" Classes.active="{Binding IsWaves}" Command="{Binding WavesCommand}" Content="∿    波形资料库" />
          <Button Classes="nav" Classes.active="{Binding IsHistory}" Command="{Binding HistoryCommand}" Content="◷    会话记录" />
          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="12,24" />
          <Button Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding SettingsCommand}" Content="⚙    偏好设置" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="14">
          <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13">
            <StackPanel Spacing="8">
              <TextBlock Text="●  本地模拟模式" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold" />
              <TextBlock Text="无需硬件，探索完整的&#10;多设备与波形工作流。" FontSize="10" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
          <TextBlock Text="YokoWave  /  0.1.0" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="12,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="30,23">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="YOKOWAVE  /  WORKSPACE" Classes="eyebrow" FontSize="9" />
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageSubtitle}" Classes="muted" FontSize="12" />
            <StackPanel x:Name="CompactNav" IsVisible="False" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
              <Button Classes="small" Content="工作台" Command="{Binding WorkspaceCommand}" />
              <Button Classes="small" Content="波形" Command="{Binding WavesCommand}" />
              <Button Classes="small" Content="记录" Command="{Binding HistoryCommand}" />
              <Button Classes="small" Content="设置" Command="{Binding SettingsCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border x:Name="ModeBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
              <TextBlock Text="●  本地模拟" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" />
            </Border>
            <Button x:Name="StopAllButton" Classes="danger" Content="■  全部停止" Command="{Binding EmergencyStopCommand}"
                    ToolTip.Tip="所有设备输出归零 · Esc" AutomationProperties.Name="全部停止" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,24,30,28">
          <!-- Workspace -->
          <StackPanel IsVisible="{Binding IsWorkspace}" Spacing="24">
            <Grid ColumnDefinitions="*,12,*,12,*">
              <Border Classes="card" Padding="18,15">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="8">
                    <TextBlock Text="已连接 / 已发现" Classes="muted" FontSize="11" />
                    <TextBlock Text="{Binding ConnectedSummary}" FontSize="26" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="⌁" FontSize="31" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Column="2" Classes="card" Padding="18,15">
                <StackPanel Spacing="8">
                  <TextBlock Text="当前会话" Classes="muted" FontSize="11" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Elapsed}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SessionState}" Foreground="{DynamicResource ChannelBBrush}" FontSize="10" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="card" Padding="18,15">
                <StackPanel Spacing="8">
                  <TextBlock Text="当前波形" Classes="muted" FontSize="11" />
                  <TextBlock Text="{Binding SelectedPreset.Name}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid x:Name="WorkspaceGrid" ColumnDefinitions="264,22,*" RowDefinitions="Auto">
              <StackPanel x:Name="DevicePane" Spacing="18">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <TextBlock Text="我的设备" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" x:Name="ScanButton" Classes="small" Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceItem">
                      <Border Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto">
                          <Button Classes="device" Classes.active="{Binding IsSelected}" Command="{Binding SelectCommand}">
                            <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto">
                              <Border Background="{DynamicResource RaisedBrush}" CornerRadius="9" Width="33" Height="36" VerticalAlignment="Center" Grid.RowSpan="2">
                                <TextBlock Text="{Binding Symbol}" FontSize="27" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                              <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Kind}" Classes="muted" FontSize="10" Margin="0,6,0,0" />
                            </Grid>
                          </Button>
                          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="4,7,4,2">
                            <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding CanEditRouting}" ToolTip.Tip="加入下次联动会话" MinHeight="26" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="small" Command="{Binding ConnectCommand}" Content="{Binding ConnectionAction}" />
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="10" Padding="14">
                  <StackPanel Spacing="9">
                    <TextBlock Text="多设备联动" FontWeight="SemiBold" FontSize="12" />
                    <ToggleSwitch x:Name="LinkModeToggle" IsChecked="{Binding LinkMode}" IsEnabled="{Binding CanEditRouting}" OnContent="同步输出" OffContent="独立控制" FontSize="11" />
                    <TextBlock Text="勾选设备后开启联动。每台设备仍遵循自己的输出上限。" FontSize="10" Classes="muted" TextWrapping="Wrap" LineHeight="17" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel x:Name="ControlPane" Grid.Column="2" Spacing="16">
                <Border Classes="card" Padding="22,18">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                      <TextBlock Text="DEVICE CONTROL" Classes="eyebrow" FontSize="9" />
                      <TextBlock Text="{Binding SelectedName}" Classes="title" />
                      <TextBlock Text="{Binding SelectedKind}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Center">
                      <TextBlock Text="{Binding SelectedBattery, StringFormat='电量  {0}'}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding SelectedSignal}" Classes="muted" FontSize="10" HorizontalAlignment="Right" />
                      <TextBlock Text="模拟读数" Classes="muted" FontSize="9" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Classes="card" Padding="22,20">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="6">
                        <TextBlock Text="波形预览" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="12 秒预览 · 归一化输出" Classes="muted" FontSize="10" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Top">
                        <TextBlock Text="● A" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" />
                        <TextBlock Text="● B" Foreground="{DynamicResource ChannelBBrush}" FontSize="11" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="30,*" RowDefinitions="*,Auto" Height="180">
                      <Grid RowDefinitions="*,*,*" Margin="0,0,0,20">
                        <TextBlock Text="100" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                        <TextBlock Grid.Row="1" Text="50" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" />
                      </Grid>
                      <controls:WaveformPlot Grid.Column="1" x:Name="MainPlot" Preset="{Binding SelectedPreset.Preset}"
                          AmplitudeA="{Binding ChannelA}" AmplitudeB="{Binding ChannelB}" Offset="{Binding OffsetChannelB}" Playhead="{Binding Playhead}" />
                      <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,10,0,0">
                        <TextBlock Text="0s" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="4s" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="8s" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="12s" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                      </Grid>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <ComboBox x:Name="PresetPicker" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditRouting}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PresetItem"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1" Content="管理波形 ↗" Classes="small" Background="{DynamicResource TransparentBrush}" Command="{Binding WavesCommand}" Margin="8,0,0,0" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,12,*">
                  <Border Classes="card" Padding="18">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="通道 A" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ChannelA, StringFormat='{}{0:0}%'}" FontSize="26" FontWeight="SemiBold" />
                      </Grid>
                      <Slider x:Name="ChannelASlider" Minimum="0" Maximum="{Binding SafetyLimit}" Value="{Binding ChannelA}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding SelectedConnected}" />
                      <TextBlock Text="{Binding SelectedDevice.OutputA, StringFormat='实时输出  {0:0.0}%'}" Classes="muted" FontSize="10" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="card" Padding="18">
                    <StackPanel Spacing="8" IsEnabled="{Binding HasChannelB}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="通道 B" Foreground="{DynamicResource ChannelBBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ChannelB, StringFormat='{}{0:0}%'}" FontSize="26" FontWeight="SemiBold" />
                      </Grid>
                      <Slider x:Name="ChannelBSlider" Minimum="0" Maximum="{Binding SafetyLimit}" Value="{Binding ChannelB}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding SelectedConnected}" />
                      <TextBlock Text="{Binding SelectedDevice.OutputB, StringFormat='实时输出  {0:0.0}%'}" Classes="muted" FontSize="10" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="card" Padding="20,16">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="输出上限" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Grid.Column="1" Text="{Binding SafetyLimit, StringFormat='{}{0:0}%'}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" />
                    </Grid>
                    <Slider x:Name="LimitSlider" Minimum="0" Maximum="100" Value="{Binding SafetyLimit}" TickFrequency="5" IsSnapToTickEnabled="True" IsEnabled="{Binding SelectedConnected}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding RoutingSummary}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="1" IsChecked="{Binding OffsetChannelB}" IsEnabled="{Binding CanEditRouting}" Content="B 通道错相" FontSize="10" MinHeight="24" />
                    </Grid>
                    <Grid ColumnDefinitions="*,14,*">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="定时" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                        <NumericUpDown x:Name="DurationInput" Value="{Binding SessionMinutes}" Minimum="1" Maximum="120" Increment="1" FormatString="0" Width="120" IsEnabled="{Binding CanEditRouting}" />
                        <TextBlock Text="分钟" FontSize="10" Classes="muted" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Grid.Column="2" x:Name="PlaybackButton" Classes="primary" Command="{Binding PlaybackCommand}" Content="{Binding PlaybackLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Text="本地模拟设备不会发送蓝牙指令。开始会话前需连接设备并调节通道强度。" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="17" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- Waveform library -->
          <StackPanel IsVisible="{Binding IsWaves}" Spacing="22">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6">
                <TextBlock Text="每个节奏，都有自己的形状。" Classes="title" />
                <TextBlock Text="选择波形即可预览。内置波形可复制，自定义波形支持编辑与 JSON 交换。" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="primary" Command="{Binding NewWaveCommand}" Content="＋ 新建波形" VerticalAlignment="Center" />
            </Grid>
            <ListBox x:Name="WaveList" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PresetItem">
                  <Border Classes="card" Width="238" Padding="16" Margin="0,0,8,8">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding ShapeLabel}" Classes="muted" FontSize="10" />
                      </Grid>
                      <controls:WaveformPlot Preset="{Binding Preset}" ShowGrid="False" Height="50" AmplitudeA="85" AmplitudeB="0" />
                      <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource ChannelBBrush}" FontSize="10" />
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Origin}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="使用所选波形 ↗" Command="{Binding UseWaveCommand}" />
              <Button Content="编辑 / 创建副本" Command="{Binding EditWaveCommand}" />
              <Button Content="删除所选" Command="{Binding DeleteWaveCommand}" />
            </StackPanel>
            <Border Classes="card" Padding="24">
              <StackPanel Spacing="16">
                <TextBlock Text="波形编辑器" FontSize="16" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,12,Auto,12,Auto">
                  <StackPanel Spacing="7">
                    <TextBlock Text="名称" Classes="muted" FontSize="11" />
                    <TextBox x:Name="WaveNameInput" Text="{Binding EditorName}" MaxLength="60" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="7">
                    <TextBlock Text="形状 · Sine / Triangle / Pulse / Ramp / Custom" Classes="muted" FontSize="10" />
                    <ComboBox x:Name="ShapePicker" ItemsSource="{Binding Shapes}" SelectedItem="{Binding EditorShape}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Spacing="7">
                    <TextBlock Text="周期 / 秒" Classes="muted" FontSize="11" />
                    <NumericUpDown Value="{Binding EditorPeriod}" Minimum="0.2" Maximum="60" Increment="0.2" FormatString="0.0" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2" Spacing="7">
                    <TextBlock Text="频率 / Hz" Classes="muted" FontSize="11" />
                    <NumericUpDown Value="{Binding EditorFrequency}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Spacing="7">
                    <TextBlock Text="自定义采样点 · Custom 形状使用，0–1 之间，以逗号分隔" Classes="muted" FontSize="11" />
                    <TextBox Text="{Binding EditorPoints}" />
                  </StackPanel>
                </Grid>
                <TextBox Text="{Binding EditorDescription}" PlaceholderText="波形描述" MaxLength="300" />
                <TextBlock Text="编辑预览 · 有效参数时显示" Classes="muted" FontSize="10" />
                <controls:WaveformPlot Preset="{Binding EditorPreview}" ShowGrid="False" Height="65" AmplitudeA="85" AmplitudeB="0" />
                <Button x:Name="SaveWaveButton" Classes="primary" Command="{Binding SaveWaveCommand}" Content="保存波形" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="24">
              <StackPanel Spacing="14">
                <TextBlock Text="导入与导出" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="支持 JSON 文件或直接粘贴。相同标识的波形会跳过，内置波形始终保留。" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="生成 JSON" Command="{Binding ExportCommand}" />
                  <Button Content="导入粘贴内容" Command="{Binding ImportCommand}" />
                  <Button x:Name="ImportFileButton" Content="打开文件…" Click="ImportFileClick" />
                  <Button x:Name="ExportFileButton" Content="保存到文件…" Click="ExportFileClick" />
                </StackPanel>
                <TextBox Text="{Binding TransferJson}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" FontFamily="Cascadia Code, monospace" FontSize="11" PlaceholderText="在这里粘贴波形 JSON，或点击生成 JSON" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- History -->
          <StackPanel IsVisible="{Binding IsHistory}" Spacing="22">
            <Grid ColumnDefinitions="*,16,*">
              <Border Classes="card" Padding="24">
                <StackPanel Spacing="10"><TextBlock Text="已完成会话" Classes="muted" /><TextBlock Text="{Binding SessionCount}" FontSize="34" Foreground="{DynamicResource AccentTextBrush}" /></StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card" Padding="24">
                <StackPanel Spacing="10"><TextBlock Text="累计体验时间" Classes="muted" /><TextBlock Text="{Binding TotalTime}" FontSize="34" Foreground="{DynamicResource ChannelBBrush}" /></StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="最近会话" Classes="title" />
            <TextBlock Text="会话结束后自动保存。记录保存在本机，最多保留 500 条。" Classes="muted" FontSize="11" />
            <ItemsControl ItemsSource="{Binding Sessions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionItem">
                  <Border Classes="card" Padding="22,18" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="110,*,Auto">
                      <TextBlock Text="{Binding Date}" Classes="muted" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap" /></StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="工作区动态" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding Activities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityItem">
                  <Grid ColumnDefinitions="85,*" Margin="0,8">
                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Settings -->
          <StackPanel IsVisible="{Binding IsSettings}" Spacing="22" MaxWidth="820" HorizontalAlignment="Left">
            <Border Classes="card" Padding="26">
              <StackPanel Spacing="12">
                <TextBlock Text="跟随系统外观" Classes="title" />
                <TextBlock Text="明暗主题与强调色跟随系统设置，在支持的平台上自动更新。" Classes="muted" TextWrapping="Wrap" LineHeight="23" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="26">
              <StackPanel Spacing="18">
                <TextBlock Text="连接与输出" Classes="title" />
                <TextBlock Text="当前驱动：本地模拟" Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="这个版本提供可运行的本地设备模拟器。真实蓝牙扫描、GATT 协议和硬件输出尚未接入；界面中的设备、电量和信号均为模拟数据。" Classes="muted" TextWrapping="Wrap" LineHeight="23" />
                <TextBlock Text="新连接设备的默认输出上限" FontSize="12" />
                <Grid ColumnDefinitions="*,60">
                  <Slider Value="{Binding DefaultLimit}" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="1" Text="{Binding DefaultLimit, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" />
                </Grid>
                <CheckBox Content="B 通道使用半周期错相" IsChecked="{Binding OffsetChannelB}" />
                <Button Classes="primary" Command="{Binding SaveSettingsCommand}" Content="保存偏好设置" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="26">
              <StackPanel Spacing="14">
                <TextBlock Text="本地与私密" Classes="title" />
                <TextBlock Text="自定义波形、偏好和会话记录仅存储在本机。不会上传账户信息，也不连接原应用服务。" Classes="muted" TextWrapping="Wrap" LineHeight="23" />
                <TextBlock Text="数据位置" FontSize="11" />
                <SelectableTextBlock Text="{Binding StoragePath}" FontSize="11" Foreground="{DynamicResource ChannelBBrush}" TextWrapping="Wrap" />
                <TextBlock Text="启动与重连时输出归零；切换设备、切换页面、定时结束及关闭应用时停止会话。Esc 可随时停止全部输出。" Classes="muted" TextWrapping="Wrap" LineHeight="23" />
              </StackPanel>
            </Border>
            <TextBlock Text="YokoWave · 波枢  0.1.0&#10;.NET 10  +  Avalonia 12&#10;Windows / macOS / Linux" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" LineHeight="24" Margin="6" />
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="●" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" x:Name="StatusText" Classes="muted" Classes.error="{Binding IsError}" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="LOCAL FIRST" Classes="eyebrow" FontSize="8" VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
