<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:YokoWave.App.Localization"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:pages="using:YokoWave.App.Views.Pages"
             x:Class="YokoWave.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource CanvasBrush}">
  <Grid x:Name="Shell" ColumnDefinitions="Auto,*">
    <Border x:Name="Sidebar" Classes="sidebar">
      <Grid RowDefinitions="Auto,*,Auto" Margin="{DynamicResource Margin.Sidebar}">
        <StackPanel Margin="{DynamicResource Margin.Brand}" Classes="field">
          <StackPanel Classes="actions">
            <Border Classes="brand-icon">
              <TextBlock Text="∿" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{DynamicResource Margin.Symbol}" Classes="icon" />
            </Border>
            <TextBlock Text="YokoWave" VerticalAlignment="Center" Classes="brand" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button Classes="nav" Classes.active="{Binding IsWorkspace}" Command="{Binding WorkspaceCommand}" Content="{l:Loc Nav.Devices}" />
          <Button Classes="nav" Classes.active="{Binding IsWaves}" Command="{Binding WavesCommand}" Content="{l:Loc Nav.Waves}" />
          <Button Classes="nav" Classes.active="{Binding IsHistory}" Command="{Binding HistoryCommand}" Content="{l:Loc Nav.History}" />
          <Border Classes="divider" />
          <Button Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding SettingsCommand}" Content="{l:Loc Nav.Settings}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Classes="items">
          <Border Classes="mode-panel">
            <TextBlock Text="{Binding ModeLabel}" Classes="label emphasis accent" />
          </Border>
          <TextBlock Text="YokoWave  /  0.1.0" Margin="{DynamicResource Margin.Horizontal}" Classes="caption muted" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Classes="header">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Classes="field">
            <TextBlock x:Name="PageTitleText" Text="{Binding PageTitle}" Classes="page-title" />
            <StackPanel x:Name="CompactNav" IsVisible="False" Margin="{DynamicResource Margin.AboveSmall}" Classes="inline">
              <Button Classes="small" Content="{l:Loc Nav.CompactDevices}" Command="{Binding WorkspaceCommand}" />
              <Button Classes="small" Content="{l:Loc Nav.CompactWaves}" Command="{Binding WavesCommand}" />
              <Button Classes="small" Content="{l:Loc Nav.CompactHistory}" Command="{Binding HistoryCommand}" />
              <Button Classes="small" Content="{l:Loc Nav.CompactSettings}" Command="{Binding SettingsCommand}" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" x:Name="StopAllButton" Classes="danger" Content="{l:Loc Action.StopAll}" Command="{Binding EmergencyStopCommand}"
                  VerticalAlignment="Center" ToolTip.Tip="{l:Loc Action.StopAllTip}" AutomationProperties.Name="{l:Loc Action.StopAllName}" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{DynamicResource Margin.Content}">
          <!-- Workspace -->
          <pages:DeviceWorkspaceView x:Name="WorkspacePage" IsVisible="{Binding IsWorkspace}" />

          <!-- Waveform library -->
          <pages:WaveformLibraryView x:Name="WavesPage" IsVisible="{Binding IsWaves}" />

          <!-- History -->
          <pages:SessionHistoryView x:Name="HistoryPage" IsVisible="{Binding IsHistory}" />

          <!-- Settings -->
          <pages:SettingsView x:Name="SettingsPage" IsVisible="{Binding IsSettings}" />


        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" Classes="statusbar">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Text="●" VerticalAlignment="Center" Margin="{DynamicResource Margin.AfterSmall}" Classes="caption accent" />
          <TextBlock Grid.Column="1" x:Name="StatusText" Classes="muted label" Classes.error="{Binding IsError}" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
