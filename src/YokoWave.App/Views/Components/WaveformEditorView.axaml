<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization"
             xmlns:controls="using:YokoWave.App.Controls"
             x:Class="YokoWave.App.Views.Components.WaveformEditorView"
             x:DataType="vm:MainViewModel">
  <Border Classes="card">
    <StackPanel Classes="group">
      <TextBlock Text="{l:Loc Wave.Editor}" Classes="section-title" />
      <Grid Classes="form" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Classes="field">
          <TextBlock Text="{l:Loc Wave.Name}" Classes="field-label" />
          <TextBox x:Name="WaveNameInput" Text="{Binding EditorName}" MaxLength="60" />
        </StackPanel>
        <StackPanel Grid.Column="1" Classes="field">
          <TextBlock Text="{l:Loc Wave.Shape}" Classes="field-label" />
          <ComboBox x:Name="ShapePicker" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ShapeItem"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Classes="field">
          <TextBlock Text="{l:Loc Wave.Period}" Classes="field-label" />
          <NumericUpDown Value="{Binding EditorPeriod}" Minimum="0.2" Maximum="60" Increment="0.2" FormatString="0.0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsGeneratedEditor}" Classes="field">
          <TextBlock Text="{l:Loc Wave.Frequency}" Classes="field-label" />
          <NumericUpDown Value="{Binding EditorFrequency}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsGeneratedEditor}" Classes="field">
          <TextBlock Text="{l:Loc Wave.PointsHelp}" Classes="field-label" />
          <TextBox Text="{Binding EditorPoints}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsSampledEditor}" Classes="field">
          <TextBlock Text="{l:Loc Wave.Samples}" Classes="field-label" />
          <TextBlock Text="{l:Loc Wave.SamplesHelp}" Classes="muted caption" TextWrapping="Wrap" />
          <TextBox Text="{Binding EditorSamples}" Classes="code-editor" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{l:Loc Wave.EditorPreview}" Classes="muted caption" />
      <controls:WaveformPlot x:Name="EditorPreviewPlot" Preset="{Binding EditorPreview}" Classes="preview" />
      <Button x:Name="SaveWaveButton" Classes="primary" Command="{Binding SaveWaveCommand}" Content="{l:Loc Wave.Save}" />
    </StackPanel>
  </Border>
</UserControl>
