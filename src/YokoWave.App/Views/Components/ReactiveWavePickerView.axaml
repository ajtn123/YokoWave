<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.ReactiveWavePickerView" x:DataType="vm:PlaybackModeViewModel">
  <StackPanel Classes="items" IsEnabled="{Binding CanEditRouting}" IsVisible="{Binding !IsRandomSleep}">
    <TextBlock Text="{l:Loc Wave.ChannelA}" Classes="field-label" />
    <ComboBox ItemsSource="{Binding PlaybackPresets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PresetItem"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <CheckBox Content="{l:Loc Wave.SeparateB}" IsChecked="{Binding SeparateWaveforms}" />
    <ComboBox ItemsSource="{Binding PlaybackPresets}" SelectedItem="{Binding SelectedPresetB}" IsVisible="{Binding SeparateWaveforms}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PresetItem"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
  </StackPanel>
</UserControl>
