<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.HardwareOutputView" x:DataType="vm:PlaybackModeViewModel" >
  <Border Classes="card compact" IsVisible="{Binding HasHardwareOptions}" IsEnabled="{Binding CanEditRouting}">
    <StackPanel Classes="items">
      <TextBlock Text="{l:Loc Hardware.Title}" Classes="section-title" />
      <StackPanel DataContext="{Binding HardwareEditor}" x:DataType="vm:HardwareOutputEditorViewModel" Classes="items">
        <StackPanel IsVisible="{Binding $parent[UserControl].((vm:PlaybackModeViewModel)DataContext).HasAuxiliaryMotor}" Classes="field">
          <TextBlock Text="{l:Loc Hardware.AuxiliaryMotor}" Classes="field-label" />
          <ComboBox ItemsSource="{Binding AuxiliaryModes}" SelectedItem="{Binding SelectedAuxiliaryMode}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SessionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{l:Loc Hardware.AuxiliaryHelp}" Classes="muted caption help" />
        </StackPanel>
        <StackPanel IsVisible="{Binding $parent[UserControl].((vm:PlaybackModeViewModel)DataContext).HasDgBalances}" Classes="items">
          <CheckBox Content="{l:Loc Hardware.Relative}" IsChecked="{Binding RelativeStrength}" />
<StackPanel Classes="field"><TextBlock Text="{l:Loc Hardware.LimitA}" Classes="field-label" /><NumericUpDown Value="{Binding LimitA}" Minimum="0" Maximum="100" FormatString="0" /></StackPanel><StackPanel Classes="field"><TextBlock Text="{l:Loc Hardware.LimitB}" Classes="field-label" /><NumericUpDown Value="{Binding LimitB}" Minimum="0" Maximum="100" FormatString="0" /></StackPanel>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
