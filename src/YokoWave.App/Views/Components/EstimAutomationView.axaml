<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization" xmlns:controls="using:YokoWave.App.Controls"
             x:Class="YokoWave.App.Views.Components.EstimAutomationView" x:DataType="vm:MainViewModel">
  <Border Classes="card compact">
    <StackPanel Classes="items">
      <ToggleButton x:Name="StrengthOptionsToggle" IsChecked="{Binding ShowStrengthOptions}" Classes="section-toggle">
        <Grid ColumnDefinitions="*,Auto" Classes="columns">
          <TextBlock Text="{l:Loc Estim.StrengthProgram}" Classes="card-title" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="{Binding StrengthOptionsSymbol}" Classes="label" />
        </Grid>
      </ToggleButton>
      <StackPanel Classes="group" IsVisible="{Binding ShowStrengthOptions}">
        <StackPanel Classes="items" IsEnabled="{Binding CanEditRouting}">
          <CheckBox Content="{l:Loc Estim.Gentle}" IsChecked="{Binding GentleMode}" />
          <TextBlock Text="{l:Loc Estim.GentleHelp}" Classes="muted caption help" />
          <CheckBox Content="{l:Loc Estim.ShowContacts}" IsChecked="{Binding ShowContacts}" />
          <ComboBox x:Name="StrengthModePicker" ItemsSource="{Binding StrengthModes}" SelectedItem="{Binding SelectedStrengthMode}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SessionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="*,*" Classes="form">
            <StackPanel Classes="field" IsVisible="{Binding IsAutomatedStrength}">
              <TextBlock Text="{l:Loc Estim.Interval}" Classes="field-label" />
              <NumericUpDown Value="{Binding StrengthInterval}" Minimum="1" Maximum="600" Increment="1" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Classes="field" IsVisible="{Binding IsRandomStrength}">
              <TextBlock Text="{l:Loc Estim.RandomAddition}" Classes="field-label" />
              <NumericUpDown Value="{Binding RandomAddition}" Minimum="0" Maximum="100" Increment="1" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Classes="field" IsVisible="{Binding IsStepStrength}">
              <TextBlock Text="{l:Loc Estim.Step}" Classes="field-label" />
              <NumericUpDown Value="{Binding StrengthStep}" Minimum="0" Maximum="100" Increment="1" FormatString="0" />
            </StackPanel>
          </Grid>
          <StackPanel Classes="field" IsVisible="{Binding IsStepStrength}">
            <TextBlock Text="{l:Loc Estim.Ceiling}" Classes="field-label" />
            <NumericUpDown Value="{Binding StrengthCeiling}" Minimum="0" Maximum="100" Increment="1" FormatString="0" />
          </StackPanel>
          <StackPanel Classes="field">
            <TextBlock Text="{l:Loc Estim.BoostAmount}" Classes="field-label" />
            <NumericUpDown Value="{Binding BoostAmount}" Minimum="0" Maximum="100" Increment="1" FormatString="0" />
          </StackPanel>
        </StackPanel>
        <controls:HoldButton x:Name="BoostButton" Content="{Binding BoostLabel}" IsHeld="{Binding IsBoostHeld}" IsEnabled="{Binding CanInteractEstim}" Classes="primary" />
        <Button Content="{l:Loc Estim.ResetStrength}" Command="{Binding ResetStrengthCommand}" IsVisible="{Binding IsAutomatedStrength}" />
        <TextBlock Text="{l:Loc Estim.StrengthHelp}" Classes="muted caption help" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
