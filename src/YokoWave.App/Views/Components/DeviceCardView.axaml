<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" x:Class="YokoWave.App.Views.Components.DeviceCardView" x:Name="Card" x:DataType="vm:DeviceItem">
  <Border Classes="list-item device-card" Classes.active="{Binding IsSelected}">
    <StackPanel Classes="field">
      <Button Classes="device" Command="{Binding SelectCommand}">
        <Grid ColumnDefinitions="Auto,*" Classes="columns">
          <TextBlock Text="{Binding Symbol}" Classes="icon accent" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Classes="field">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Classes="small emphasis" />
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Classes="caption muted" />
          </StackPanel>
        </Grid>
      </Button>
      <TextBlock Text="{Binding OutputSummary}" IsVisible="{Binding HasOutput}" Classes="caption muted" TextWrapping="Wrap" />
      <Button Content="{Binding ConnectionAction}" Command="{Binding ConnectCommand}" HorizontalAlignment="Right"
              IsVisible="{Binding ShowConnectionAction, ElementName=Card}"
              Classes="small connection-action" Classes.primary="{Binding !IsConnected}" Classes.danger="{Binding IsConnected}" />
      <Button Content="{Binding AssignmentLabel, ElementName=Card}" Command="{Binding AssignmentCommand, ElementName=Card}"
              IsVisible="{Binding ShowAssignmentAction, ElementName=Card}" Classes="small" />
    </StackPanel>
  </Border>
</UserControl>
