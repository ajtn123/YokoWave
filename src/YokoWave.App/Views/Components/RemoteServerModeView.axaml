<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.RemoteServerModeView" x:DataType="vm:PlaybackModeViewModel" IsVisible="{Binding IsServerMode}">
  <Border Classes="card">
    <StackPanel Classes="items">
      <TextBlock Text="{l:Loc ModeKind.WebSocketServer}" Classes="section-title" />
      <StackPanel DataContext="{Binding ServerEditor}" x:DataType="vm:RemoteServerEditorViewModel" Classes="items">
        <StackPanel IsEnabled="{Binding $parent[UserControl].((vm:PlaybackModeViewModel)DataContext).CanEditRouting}" Classes="items">
          <TextBlock Text="{l:Loc Remote.BindAddress}" Classes="field-label" />
          <TextBox Text="{Binding Address}" />
          <Grid ColumnDefinitions="*,*" Classes="columns">
            <StackPanel Classes="field"><TextBlock Text="{l:Loc Remote.Port}" Classes="field-label" /><NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" /></StackPanel>
            <StackPanel Grid.Column="1" Classes="field"><TextBlock Text="{l:Loc Remote.LeaseTime}" Classes="field-label" /><NumericUpDown Value="{Binding LeaseMilliseconds}" Minimum="1000" Maximum="10000" Increment="100" FormatString="0" /></StackPanel>
          </Grid>
          <TextBlock Text="{l:Loc Remote.ControlLimit}" Classes="field-label" />
          <Slider Value="{Binding ControlLimit}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
          <TextBlock Text="{Binding ControlLimit, StringFormat='{}{0:0}%'}" Classes="muted caption" />
          <TextBlock Text="{l:Loc Remote.Certificate}" Classes="field-label" />
          <TextBox Text="{Binding CertificatePath}" />
          <TextBlock Text="{l:Loc Remote.CertificatePassword}" Classes="field-label" />
          <TextBox Text="{Binding CertificatePassword}" PasswordChar="●" />
        </StackPanel>
        <TextBlock Text="{l:Loc Remote.Token}" Classes="field-label" />
        <SelectableTextBlock Text="{Binding Token}" TextWrapping="Wrap" Classes="caption" />
        <TextBlock Text="{l:Loc Remote.Url}" Classes="field-label" />
        <SelectableTextBlock Text="{Binding Url}" TextWrapping="Wrap" Classes="caption" />
        <TextBlock Text="{l:Loc Remote.ServerHelp}" Classes="muted caption help" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
