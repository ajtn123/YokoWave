<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization" xmlns:controls="using:YokoWave.App.Controls"
             x:Class="YokoWave.App.Views.Components.TouchControlView" x:DataType="vm:MainViewModel">
  <StackPanel Classes="items">
    <TextBlock Text="{l:Loc Touch.Help}" Classes="muted caption help" />
    <controls:ElectricalPad x:Name="FrequencyPad" Frequency="{Binding TouchFrequency}" PulseWidth="{Binding TouchPulseWidth}"
                            IsHeld="{Binding IsTouchHeld}" IsEnabled="{Binding CanInteractEstim}" AutomationProperties.Name="{l:Loc Touch.Title}" />
    <TextBlock Text="{Binding TouchCoordinates}" Classes="label accent" />
    <ComboBox x:Name="TouchPlaybackPicker" ItemsSource="{Binding TouchPlaybackModes}" SelectedItem="{Binding SelectedTouchPlayback}"
              IsEnabled="{Binding CanEditRouting}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SessionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding RecordingSummary}" Classes="muted caption" />
    <StackPanel Classes="field" IsVisible="{Binding HasRecording}">
      <TextBox Text="{Binding TouchRecordingName}" PlaceholderText="{l:Loc Wave.Name}" MaxLength="60" />
      <Button Content="{l:Loc Touch.SaveRecording}" Command="{Binding SaveRecordingCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
