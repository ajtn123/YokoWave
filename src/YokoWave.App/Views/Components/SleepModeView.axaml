<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             xmlns:components="using:YokoWave.App.Views.Components"
             x:Class="YokoWave.App.Views.Components.SleepModeView" x:DataType="vm:PlaybackModeViewModel" IsVisible="{Binding IsSleep}">
  <Border Classes="card">
    <StackPanel Classes="group">
      <TextBlock Text="{l:Loc Sleep.Help}" Classes="muted caption help" />
      <StackPanel Classes="items" IsEnabled="{Binding CanEditRouting}">
        <ComboBox x:Name="SleepCyclePicker" ItemsSource="{Binding SleepCycles}" SelectedItem="{Binding SelectedSleepCycle}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SessionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="*,*" Classes="form" IsVisible="{Binding !IsRandomSleep}">
          <StackPanel Classes="field">
            <TextBlock Text="{l:Loc Sleep.IntervalSeconds}" Classes="field-label" />
            <NumericUpDown Minimum="1" Maximum="7200" Value="{Binding IntervalSeconds}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Classes="field">
            <TextBlock Text="{l:Loc Reactive.BurstSeconds}" Classes="field-label" />
            <NumericUpDown Minimum="1" Maximum="60" Value="{Binding BurstSeconds}" />
          </StackPanel>
        </Grid>
        <StackPanel Classes="items" IsVisible="{Binding IsRandomSleep}">
          <TextBlock Text="{l:Loc Sleep.IntervalRange}" Classes="field-label" />
          <Grid ColumnDefinitions="*,*" Classes="form">
            <NumericUpDown Minimum="1" Maximum="7200" Value="{Binding MinimumIntervalSeconds}" AutomationProperties.Name="{l:Loc Range.Minimum}" />
            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="7200" Value="{Binding MaximumIntervalSeconds}" AutomationProperties.Name="{l:Loc Range.Maximum}" />
          </Grid>
          <TextBlock Text="{l:Loc Sleep.BurstRange}" Classes="field-label" />
          <Grid ColumnDefinitions="*,*" Classes="form">
            <NumericUpDown Minimum="1" Maximum="60" Value="{Binding MinimumBurstSeconds}" AutomationProperties.Name="{l:Loc Range.Minimum}" />
            <NumericUpDown Grid.Column="1" Minimum="1" Maximum="60" Value="{Binding MaximumBurstSeconds}" AutomationProperties.Name="{l:Loc Range.Maximum}" />
          </Grid>
          <TextBlock Text="{l:Loc Sleep.StrengthRange}" Classes="field-label" />
          <Grid ColumnDefinitions="*,*" Classes="form">
            <NumericUpDown Minimum="0" Maximum="100" Value="{Binding MinimumStrengthPercent}" AutomationProperties.Name="{l:Loc Range.Minimum}" />
            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MaximumStrengthPercent}" AutomationProperties.Name="{l:Loc Range.Maximum}" />
          </Grid>
          <components:ModePlaylistView />
        </StackPanel>
        <components:ReactiveWavePickerView />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" Classes="columns" IsVisible="{Binding IsRunning}">
        <TextBlock Text="{Binding InputPhaseLabel}" Classes="label accent" />
        <TextBlock Grid.Column="1" Text="{Binding ReactiveCountdown}" Classes="label" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
