<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.ProtocolFeaturesView" x:DataType="vm:ProtocolFeaturesViewModel" >
  <Expander Header="{l:Loc Protocol.Title}" IsVisible="{Binding IsVisible}" HorizontalAlignment="Stretch">
    <StackPanel Classes="items">
      <TextBlock Text="{l:Loc Protocol.Help}" Classes="muted caption help" />
      <ComboBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProtocolCommandOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding Help}" Classes="muted caption help" />
      <ItemsControl ItemsSource="{Binding Parameters}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProtocolParameter">
            <StackPanel Classes="field" Margin="{DynamicResource Margin.BelowLarge}">
              <TextBlock Text="{Binding Group}" Classes="muted caption" IsVisible="{Binding HasGroup}" />
              <TextBlock Text="{Binding Label}" Classes="field-label" IsVisible="{Binding !IsBoolean}" />
              <NumericUpDown Value="{Binding Number}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" FormatString="0" IsVisible="{Binding IsNumber}" />
              <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}" IsVisible="{Binding IsBoolean}" />
              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SessionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <WrapPanel>
        <Button Content="{l:Loc Protocol.Apply}" Command="{Binding ApplyCommand}" Classes="small primary" />
        <Button Content="{l:Loc Protocol.ResetDraft}" Command="{Binding ResetDraftCommand}" Classes="small" />
        <Button Content="{l:Loc Protocol.UseCalibration}" Command="{Binding UseCalibrationCommand}" IsVisible="{Binding HasCalibration}" Classes="small" />
      </WrapPanel>
      <Expander Header="{l:Loc Protocol.Readings}"><SelectableTextBlock Text="{Binding Readings}" TextWrapping="Wrap" Classes="muted caption" /></Expander>
    </StackPanel>
  </Expander>
</UserControl>
