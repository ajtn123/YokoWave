<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.WaveformTransferView"
             x:DataType="vm:MainViewModel">
  <Border Classes="card">
    <StackPanel Classes="items">
      <TextBlock Text="{l:Loc Transfer.Title}" Classes="section-title" />
      <TextBlock Text="{l:Loc Transfer.Help}" Classes="muted label" TextWrapping="Wrap" />
      <StackPanel Classes="actions">
        <Button Content="{l:Loc Transfer.Generate}" Command="{Binding ExportCommand}" />
        <Button Content="{l:Loc Transfer.ImportText}" Command="{Binding ImportCommand}" />
        <Button x:Name="ImportFileButton" Content="{l:Loc Transfer.Open}" Click="ImportFileClick" />
        <Button x:Name="ExportFileButton" Content="{l:Loc Transfer.Save}" Click="ExportFileClick" />
      </StackPanel>
      <TextBox Text="{Binding TransferJson}" TextWrapping="Wrap" PlaceholderText="{l:Loc Transfer.Placeholder}" Classes="code-editor" />
    </StackPanel>
  </Border>
</UserControl>
