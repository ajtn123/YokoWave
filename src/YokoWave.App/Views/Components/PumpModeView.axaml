<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.PumpModeView" x:DataType="vm:PlaybackModeViewModel" IsVisible="{Binding IsPump}">
  <Border Classes="card">
    <StackPanel Classes="items">
      <TextBlock Text="{l:Loc ModeKind.Pump}" Classes="section-title" />
      <StackPanel Classes="field">
        <TextBlock Text="{l:Loc Pump.Direction}" Classes="field-label" />
        <ComboBox x:Name="PumpDirectionPicker" ItemsSource="{Binding PumpDirections}" SelectedItem="{Binding SelectedPumpDirection}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SessionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <ToggleSwitch x:Name="WaterPumpSwitch" Content="{l:Loc Pump.Water}" OnContent="{l:Loc State.On}" OffContent="{l:Loc State.Off}" IsChecked="{Binding WaterEnabled}" />
      <TextBlock Text="{l:Loc Pump.Help}" Classes="muted caption help" />
    </StackPanel>
  </Border>
</UserControl>
