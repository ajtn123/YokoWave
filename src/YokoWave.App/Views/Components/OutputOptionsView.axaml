<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels.Pipelines" xmlns:items="using:YokoWave.App.ViewModels"
             xmlns:l="using:YokoWave.App.Localization" x:Class="YokoWave.App.Views.Components.OutputOptionsView" x:DataType="vm:OutputOptionsViewModel">
  <Expander Header="{l:Loc Hardware.Title}">
    <StackPanel Classes="field">
      <CheckBox Content="{l:Loc Estim.Gentle}" IsChecked="{Binding Gentle}" />
      <StackPanel DataContext="{Binding Hardware}" x:DataType="items:HardwareOutputEditorViewModel" Classes="field">
        <TextBlock Text="{l:Loc Hardware.AuxiliaryMotor}" Classes="field-label" />
        <ComboBox ItemsSource="{Binding AuxiliaryModes}" SelectedItem="{Binding SelectedAuxiliaryMode}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="items:SessionOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Content="{l:Loc Hardware.Relative}" IsChecked="{Binding RelativeStrength}" />
        <TextBlock Text="{l:Loc Hardware.LimitA}" Classes="field-label" /><NumericUpDown Value="{Binding LimitA}" Minimum="0" Maximum="100" />
        <TextBlock Text="{l:Loc Hardware.LimitB}" Classes="field-label" /><NumericUpDown Value="{Binding LimitB}" Minimum="0" Maximum="100" />
      </StackPanel>
      <TextBlock Text="{l:Loc Dg.Balances}" Classes="card-title" />
      <TextBlock Text="{l:Loc Dg.FrequencyA}" Classes="field-label" /><NumericUpDown Value="{Binding FrequencyA}" Minimum="0" Maximum="255" />
      <TextBlock Text="{l:Loc Dg.FrequencyB}" Classes="field-label" /><NumericUpDown Value="{Binding FrequencyB}" Minimum="0" Maximum="255" />
      <TextBlock Text="{l:Loc Dg.WidthA}" Classes="field-label" /><NumericUpDown Value="{Binding WidthA}" Minimum="0" Maximum="255" />
      <TextBlock Text="{l:Loc Dg.WidthB}" Classes="field-label" /><NumericUpDown Value="{Binding WidthB}" Minimum="0" Maximum="255" />
    </StackPanel>
  </Expander>
</UserControl>
