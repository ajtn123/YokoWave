<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.RestraintModeView" x:DataType="vm:PlaybackModeViewModel" IsVisible="{Binding IsRestraint}">
  <Border Classes="card">
    <StackPanel Classes="group">
      <TextBlock Text="{l:Loc Restraint.Help}" Classes="muted caption help" />
      <Grid ColumnDefinitions="*,*" Classes="form" IsEnabled="{Binding CanEditRouting}">
        <StackPanel Classes="field">
          <TextBlock Text="{l:Loc Restraint.SafeAngle}" Classes="field-label" />
          <NumericUpDown x:Name="SafeAngleInput" Minimum="0" Maximum="90" Value="{Binding SafeAngle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Classes="field">
          <TextBlock Text="{l:Loc Restraint.RampAngle}" Classes="field-label" />
          <NumericUpDown Minimum="1" Maximum="180" Value="{Binding RampAngle}" />
        </StackPanel>
      </Grid>
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding InputLevel}" Classes="session-timer" />
      <Button Content="{l:Loc Restraint.Recalibrate}" Command="{Binding RecalibrateMotionCommand}" />
    </StackPanel>
  </Border>
</UserControl>
