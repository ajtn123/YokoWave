<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.DeviceFeaturesView" x:DataType="vm:DevicesPaneViewModel">
  <StackPanel Classes="field" IsVisible="{Binding HasDeviceFeatures}">
    <TextBlock Text="{Binding FirmwareLabel}" Classes="muted caption" />
    <Grid ColumnDefinitions="*,Auto,Auto" Classes="columns">
      <TextBlock Text="{Binding LightLabel}" VerticalAlignment="Center" Classes="label" />
      <Button Grid.Column="1" x:Name="ReadDeviceFeaturesButton" Content="{l:Loc Device.ReadFeatures}" Command="{Binding ReadDeviceFeaturesCommand}" Classes="small" />
      <Button Grid.Column="2" x:Name="ToggleLightButton" Content="{Binding LightAction}" Command="{Binding ToggleLightCommand}" Classes="small" />
    </Grid>
  </StackPanel>
</UserControl>
