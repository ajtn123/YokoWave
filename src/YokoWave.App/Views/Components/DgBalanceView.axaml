<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YokoWave.App.ViewModels" xmlns:l="using:YokoWave.App.Localization"
             x:Class="YokoWave.App.Views.Components.DgBalanceView" x:DataType="vm:PlaybackModeViewModel" IsVisible="{Binding HasDgBalances}">
  <Border Classes="card compact">
    <StackPanel Classes="items" IsEnabled="{Binding CanEditRouting}">
      <TextBlock Text="{l:Loc Dg.Balances}" Classes="card-title" />
      <Grid Classes="form" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
        <StackPanel Classes="field">
          <TextBlock Text="{l:Loc Dg.FrequencyA}" Classes="field-label" />
          <NumericUpDown Value="{Binding FrequencyBalanceA}" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Classes="field">
          <TextBlock Text="{l:Loc Dg.FrequencyB}" Classes="field-label" />
          <NumericUpDown Value="{Binding FrequencyBalanceB}" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Classes="field">
          <TextBlock Text="{l:Loc Dg.WidthA}" Classes="field-label" />
          <NumericUpDown Value="{Binding WidthBalanceA}" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Classes="field">
          <TextBlock Text="{l:Loc Dg.WidthB}" Classes="field-label" />
          <NumericUpDown Value="{Binding WidthBalanceB}" Minimum="0" Maximum="255" Increment="1" FormatString="0" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{l:Loc Dg.BalanceHelp}" Classes="muted caption help" />
    </StackPanel>
  </Border>
</UserControl>
