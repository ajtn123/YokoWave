<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:YokoWave.App.Localization" xmlns:vm="using:YokoWave.App.ViewModels.Pipelines"
             xmlns:views="using:YokoWave.App.Views.Pipelines"
             x:Class="YokoWave.App.Views.Pipelines.PipelinesWorkspaceView" x:DataType="vm:PipelinesWorkspaceViewModel">
  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Space.Medium}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Classes="items pipeline-list">
        <StackPanel.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:Loc Pipeline.Duplicate}" Command="{Binding DuplicateCommand}" />
            <MenuItem Header="{l:Loc Pipeline.Save}" Command="{Binding SaveCommand}" />
            <MenuItem Header="{l:Loc Pipeline.Delete}" Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="{l:Loc Pipeline.SaveTemplate}" IsEnabled="{Binding CanEditSelected}" Click="SaveTemplate" />
            <MenuItem Header="{l:Loc Pipeline.DeleteTemplate}" Command="{Binding DeleteTemplateCommand}" />
          </ContextMenu>
        </StackPanel.ContextMenu>
        <Grid ColumnDefinitions="*,Auto" Classes="columns">
          <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" HorizontalAlignment="Stretch" Classes="pipeline-create" AutomationProperties.Name="{l:Loc Pipeline.Template}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PipelineTemplateChoice"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Content="{l:Loc Mode.Add}" Command="{Binding AddCommand}" Classes="small primary pipeline-create" />
        </Grid>
        <ItemsControl x:Name="PipelineGroups" ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PipelineDeviceGroupViewModel">
          <Border Classes="list-item card compact mode-group" Classes.active="{Binding IsSelected}" ContextRequested="SelectContextPipeline">
            <StackPanel Classes="field">
              <Button Command="{Binding SelectCommand}" Classes="mode-select">
                <ContentControl Content="{Binding Editor}"><ContentControl.ContentTemplate><DataTemplate x:DataType="vm:PipelineEditorViewModel">
                  <StackPanel Classes="field"><TextBlock Text="{Binding Name}" Classes="small emphasis" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding StateLabel}" Classes="caption accent" /></StackPanel>
                </DataTemplate></ContentControl.ContentTemplate></ContentControl>
              </Button>
              <ItemsControl ItemsSource="{Binding Devices}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PipelineDeviceCardViewModel"><views:PipelineDeviceCardView /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="{l:Loc Pipeline.NoConnectedDevices}" IsVisible="{Binding !HasDevices}" Classes="caption muted" />
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{l:Loc Mode.Unassigned}" Classes="small emphasis" />
        <ItemsControl x:Name="UnassignedDeviceList" ItemsSource="{Binding UnassignedDevices}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PipelineDeviceCardViewModel"><views:PipelineDeviceCardView /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{l:Loc Mode.NoUnassigned}" IsVisible="{Binding !HasUnassignedDevices}" Classes="caption muted" />
      </StackPanel>
    </ScrollViewer>
    <ContentControl Grid.Column="1" Content="{Binding Selected}"><ContentControl.ContentTemplate><DataTemplate x:DataType="vm:PipelineEditorViewModel"><views:PipelineEditorView /></DataTemplate></ContentControl.ContentTemplate></ContentControl>
  </Grid>
</UserControl>
