<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:YokoWave.App.Controls"
             xmlns:localization="using:YokoWave.Core.Localization"
             x:Class="YokoWave.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://YokoWave.App/Styles/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Leaving Accent unset lets Fluent track the platform's accent color. -->
    <FluentTheme />
    <Style Selector="NumericUpDown">
      <Setter Property="NumberFormat" Value="{ReflectionBinding Culture.NumberFormat, Source={x:Static localization:L10n.Current}}" />
    </Style>
    <Style Selector="controls|WaveformPlot">
      <Setter Property="GridBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="ChannelABrush" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="ChannelBBrush" Value="{DynamicResource ChannelBBrush}" />
      <Setter Property="AreaBrush" Value="{DynamicResource AccentAreaBrush}" />
      <Setter Property="PlayheadBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Noto Sans CJK SC, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.device">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.device.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="10,9" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Application.Styles>
</Application>
