<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YokoWave.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://YokoWave.App/Styles/Palette.axaml" />
        <ResourceInclude Source="avares://YokoWave.App/Styles/Metrics.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />
    <StyleInclude Source="avares://YokoWave.App/Styles/Controls.axaml" />
    <StyleInclude Source="avares://YokoWave.App/Styles/Typography.axaml" />
    <StyleInclude Source="avares://YokoWave.App/Styles/Layout.axaml" />
    <StyleInclude Source="avares://YokoWave.App/Styles/Components.axaml" />
    <StyleInclude Source="avares://YokoWave.App/Styles/Pipelines.axaml" />
  </Application.Styles>
</Application>
