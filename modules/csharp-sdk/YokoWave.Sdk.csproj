<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../sdk-version.txt').Trim())</Version>
    <Description>YokoWave event, control, GATT and DG-LAB V4 clients.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ajtn123/YokoWave</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/YokoWave.Core/YokoWave.Core.csproj" />
    <InternalsVisibleTo Include="YokoWave.Remote" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
